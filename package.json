{
  "name": "ulportal",
  "version": "1.2.2",
  "description": "Unofficial desktop client for portal.ulsu.ru (Ulyanovsk State University)",
  "author": "Maksim Surgutskii",
  "license": "MIT",
  "homepage": "https://rgb-outl4w.github.io/UlSU-Portal-Desktop/",
  "repository": {
    "type": "git",
    "url": "https://github.com/RGB-Outl4w/UlSU-Portal-Desktop.git"
  },
  "bugs": {
    "url": "https://github.com/RGB-Outl4w/UlSU-Portal-Desktop/issues"
  },
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "android:sync": "node build-www.js && cap sync android"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ru.ulportal.app",
    "productName": "ULSU Portal Desktop",
    "copyright": "© 2026 Maksim Surgutskii",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app.js",
      "layout.js",
      "i18n.js",
      "index.html",
      "app.css",
      "offline.html",
      "logo.svg",
      "icon.png",
      "iconTemplate@2x.png",
      "iconTemplate.png",
      "LICENSE",
      "LICENSE.ru.md",
      "NOTICE.md",
      "PRIVACY.md",
      "PRIVACY.ru.md",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "УлГУ · Портал студента",
      "license": "LICENSE",
      "artifactName": "ULSU-Portal-Desktop-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "multiLanguageInstaller": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "ULSU-Portal-Desktop-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "ULSU Portal Desktop ${version}",
      "artifactName": "ULSU-Portal-Desktop-${version}-${arch}.${ext}"
    }
  }
}
